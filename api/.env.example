# Oracle API — required env vars
# Copy to .env and fill in values

# Shared secret for x-api-key header (generate with: openssl rand -hex 32)
ORACLE_API_KEY=change-me

# Path to retro data directory (contains leaderboard.json)
DATA_DIR=/home/ubuntu/truthmachine/data

# Optional: override leaderboard path directly
# LEADERBOARD_PATH=/home/ubuntu/truthmachine/data/leaderboard.json

# How often to re-read leaderboard.json (seconds)
LEADERBOARD_REFRESH_SECONDS=300

# Max articles to search per /forecast request
MAX_ARTICLES=5

# --- Shared with pipeline .env (copy from there) ---
SERPERDEV_KEY=
BRAVE_API_KEY=
OPENROUTER_API_KEY=
AWS_REGION=us-east-1
GATEKEEPER_MODEL=bedrock/us.amazon.nova-micro-v1:0
EXTRACTOR_MODEL=bedrock/us.amazon.nova-lite-v1:0

# --- MCP server / OAuth 2.1 (Cognito) — see docs/ORACLE_MCP.md ---
# All three OPTIONAL: leave blank to run without the /mcp endpoint. Set them
# (after the Cognito user pool exists) to enable the MCP server. Region is
# derived from the pool-id prefix if COGNITO_REGION is omitted.
COGNITO_USER_POOL_ID=
# COGNITO_REGION=eu-central-1
# Comma-separated Cognito app-client IDs allowed to call /mcp (Claude + M2M)
COGNITO_ALLOWED_CLIENT_IDS=
# Public URL of this Resource Server (OAuth resource indicator)
# MCP_RESOURCE_URL=https://oracle.daatan.com/mcp
# --- DCR façade: human Claude-connector login (optional, needs BOTH) ---
# Cognito has no Dynamic Client Registration, which Claude's connector requires.
# Setting both makes the Oracle origin advertise itself as the auth server and
# expose /register (returns the static public client). Leave blank for the
# M2M-only path. See docs/ORACLE_MCP.md.
# COGNITO_HOSTED_UI_DOMAIN=https://daatan-oracle.auth.eu-central-1.amazoncognito.com
# COGNITO_CLAUDE_CLIENT_ID=
