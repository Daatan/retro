            "weight": 0.6,
            "settled": null,
            "settlement_event_date": null
          }
        ]
      }
    },
    {
      "id": "A3",
      "name": "off-topic-only pool abstains rather than estimating",
      "traces": [
        "R3"
      ],
      "notes": "Relevance 0.2 on a single article gives relevance_mass 0.04, below relevance_weight_floor — the pipeline must abstain with all_articles_off_topic instead of reporting a confident stance from tangential coverage.",
      "articles": [
        {
          "source": "alpha",
          "published_date": "2026-08-01",
          "relevance": 0.2,
