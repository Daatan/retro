{
  "group": "A",
  "title": "Intra-article composition — many claims to one article signal",
  "notes": "Group A holds the article boundary: how a set of extracted claims collapses into the single (stance, certainty, evidence_weight, settled, fact_signal) tuple the pool then sees. Most of the lane-soundness Tier-S findings live here — F1 is precisely the claim that this collapse is lossy.",
  "cases": [
    {
      "id": "A1",
      "name": "single claim passes through unchanged",
      "traces": [
        "M1"
      ],
      "notes": "The degenerate case: one claim, neutral credibility, same-day article, full relevance. Its stance is the article's stance and the pooled mean is that stance back through the logit round-trip.",
      "articles": [
        {
          "source": "alpha",
          "published_date": "2026-08-01",
          "relevance": 1.0,
          "credibility": 1.0,
          "claims": [
            {
              "stance": 0.6,
              "certainty": 0.8,
              "evidence_class": "reporting"
            }
          ]
        }
      ],
      "invariants": [
        "abs(sources[0]['stance'] - 0.6) < 1e-9",
        "abs(mean - 0.6) < 1e-6",
        "sources[0]['recency_weight'] == 1.0"
      ],
      "expect": {
        "insufficient_data": false,
        "reason": null,
