      ],
      "notes": "Two opposing claims in one article: decisive +0.9 at certainty 0.9, hedged -0.9 at certainty 0.1. A flat mean would cancel to 0; certainty weighting must land near the decisive claim.",
      "articles": [
        {
          "source": "alpha",
          "published_date": "2026-08-01",
          "relevance": 1.0,
          "credibility": 1.0,
          "claims": [
            {
              "stance": 0.9,
              "certainty": 0.9,
              "evidence_class": "reporting"
