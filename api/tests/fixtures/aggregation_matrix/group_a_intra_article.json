{
  "group": "A",
  "title": "Intra-article composition — claims to one article signal",
  "cases": [
    {
      "id": "A1",
      "name": "single claim passes through unchanged",
      "traces": [
        "M1"
      ],
      "notes": "The degenerate case: one claim, neutral credibility, same-day article, full relevance. Its stance is the article's stance and the pooled mean is that stance back through the logit round-trip.",
      "articles": [
        {
          "source": "alpha",
          "published_date": "2026-08-01",
          "relevance": 1.0,
          "credibility": 1.0,
          "claims": [
            {
              "stance": 0.6,
              "certainty": 0.8,
              "evidence_class": "reporting"
            }
          ]
        }
      ],
      "invariants": [
        "abs(sources[0]['stance'] - 0.6) < 1e-9",
        "abs(mean - 0.6) < 1e-6",
        "sources[0]['recency_weight'] == 1.0"
      ],
      "expect": {
        "insufficient_data": false,
        "reason": null,
        "articles_used": 1,
        "settled": false,
        "mean": 0.6,
        "std": 0.0,
        "ci_low": 0.6,
        "ci_high": 0.6,
        "sources": [
          {
            "source": "alpha",
            "stance": 0.6,
            "certainty": 0.8,
            "credibility_weight": 1.0,
            "evidence_class": "reporting",
            "evidence_weight": 0.6,
            "recency_weight": 1.0,
            "relevance_score": 1.0,
            "weight": 0.6,
            "settled": null,
            "settlement_event_date": null
          }
        ]
      }
    },
    {
      "id": "A2",
      "name": "certainty weighting lets the decisive claim dominate the hedged one",
      "traces": [
