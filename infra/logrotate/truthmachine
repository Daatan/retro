# Batch loop log (retro#838). truthmachine.service writes it with
# StandardOutput=append:, so copytruncate is safe and needs no service restart.
# Reached 4.2 GB unrotated by 2026-09-19. oracle_log.txt is deliberately NOT here:
# audits and shadow-flag reviews read months of it in place.
#
# Install once on the box (root):
#   sudo install -m 644 /home/ubuntu/truthmachine/infra/logrotate/truthmachine /etc/logrotate.d/truthmachine
/home/ubuntu/truthmachine/pipeline_log.txt {
    su ubuntu ubuntu
    weekly
    maxsize 200M
    rotate 4
    compress
    delaycompress
    copytruncate
    missingok
    notifempty
}
