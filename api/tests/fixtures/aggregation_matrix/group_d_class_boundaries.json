    {
      "id": "D2",
      "name": "a claim the classifier skipped outranks one it classified",
      "traces": [
        "R3",
        "F1"
      ],
      "notes": "Unclassified evidence falls back to its own certainty, so a confident claim the extractor never labelled (certainty 0.95 → weight 0.95) outweighs an identically confident claim it did label as reporting (0.6). Silence about the evidence type buys more influence than the answer would have.",
      "articles": [
        {
          "source": "alpha",
          "published_date": "2026-08-01",
          "relevance": 1.0,
          "credibility": 1.0,
          "claims": [
            {
              "stance": 0.7,
              "certainty": 0.95
            }
          ]
        },
        {
          "source": "bravo",
          "published_date": "2026-08-01",
          "relevance": 1.0,
          "credibility": 1.0,
          "claims": [
            {
              "stance": -0.7,
              "certainty": 0.95,
              "evidence_class": "reporting"
            }
          ]
        }
      ],
      "invariants": [
        "sources[0]['evidence_class'] is None",
        "abs(sources[0]['evidence_weight'] - 0.95) < 1e-9",
        "sources[0]['weight'] > sources[1]['weight']",
        "mean > 0"
      ],
      "known_bad": {
        "finding": "R3",
        "expected_behavior": "A missing evidence_class is missing data. The fallback may not exceed what the classifier would have granted — under R3 it should sit at or below the weakest plausible class, never above a classified peer."
      },
