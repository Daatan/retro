    {
      "id": "A4",
      "name": "reported fact and the author's own conclusion collapse into one number",
      "traces": [
        "F1",
        "R5"
      ],
      "notes": "The founding F1 case. The article reports a mild fact (+0.2, reported_fact, weight 1.0) and the columnist's confident conclusion (+0.95, opinion, weight 0.25). Two different KINDS of evidence, and the article emits one stance plus one evidence_weight that is the flat mean of two class weights — so the opinion drags the stance up while the fact's class weight subsidises it. Nothing downstream can separate them again.",
      "articles": [
        {
          "source": "alpha",
          "published_date": "2026-08-01",
          "relevance": 1.0,
          "credibility": 1.0,
          "claims": [
            {
              "stance": 0.2,
              "certainty": 0.8,
              "evidence_class": "reported_fact"
            },
            {
              "stance": 0.95,
              "certainty": 0.8,
              "evidence_class": "opinion"
            }
          ]
        }
      ],
      "invariants": [
        "abs(sources[0]['stance'] - 0.575) < 1e-9",
        "abs(sources[0]['evidence_weight'] - 0.625) < 1e-9"
      ],
      "known_bad": {
        "finding": "F1",
        "expected_behavior": "Under claims_detail persistence the fact and the conclusion stay separable, each carrying its own class weight, instead of averaging into a single stance at a single blended weight."
      },
      "expect": {
