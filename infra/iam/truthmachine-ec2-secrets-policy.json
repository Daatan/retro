{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDaatanSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:eu-central-1:<ACCOUNT_ID>:secret:daatan/*",
        "arn:aws:secretsmanager:eu-central-1:<ACCOUNT_ID>:secret:openclaw/*",
        "arn:aws:secretsmanager:eu-central-1:<ACCOUNT_ID>:secret:metaculus/*"
      ]
    }
  ]
}
